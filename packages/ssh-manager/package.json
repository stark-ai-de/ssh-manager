{
  "name": "@stark-ai/ssh-manager",
  "version": "1.0.0",
  "description": "Reusable TypeScript SSH management with explicit trust, target grants and resource lifecycles.",
  "keywords": [
    "sftp",
    "ssh",
    "ssh-manager",
    "ssh2",
    "typescript"
  ],
  "homepage": "https://github.com/stark-ai-de/ssh-manager#readme",
  "bugs": {
    "url": "https://github.com/stark-ai-de/ssh-manager/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stark-ai-de/ssh-manager.git",
    "directory": "packages/ssh-manager"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ssh2": "^1.15.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
