{
  "name": "ssh-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Independent SSH management library, local daemon, terminal viewer and MCP adapter.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stark-ai-de/ssh-manager.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/ssh/build.mjs",
    "test": "node scripts/ssh/test.mjs",
    "validate": "pnpm run build && pnpm run test",
    "artifact": "node scripts/ssh/export-artifact.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "oxfmt": "0.71.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@12.9.1"
}
