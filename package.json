{
  "name": "ssh-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Independent SSH management library, local daemon, terminal viewer and MCP adapter.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stark-ai-de/ssh-manager.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/ssh/build.mjs",
    "test": "node scripts/ssh/test.mjs",
    "validate": "pnpm run format:check && pnpm run build && pnpm run docs:check && pnpm run test && pnpm run pack:check",
    "docs:check": "node scripts/repo/check-docs.mjs",
    "pack:check": "node scripts/ssh/check-packages.mjs",
    "artifact": "node scripts/ssh/export-artifact.mjs",
    "artifact:verify": "node scripts/ssh/verify-artifact.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:mcp:duration": "node scripts/ssh/test-mcp-duration.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.3",
    "oxfmt": "0.73.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@12.9.1"
}
